# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
ADMIN_ROLE_ID=
ADMIN_ALERT_CHANNEL_ID=
TICKET_CATEGORY_ID=
TESTIMONI_CHANNEL_ID=

# Role tingkatan pembeli (Buyer Loyalty Roles)
BUYER_ROLE_ID=
ROLE_CUSTOMER=
ROLE_500K=
ROLE_1JT=
ROLE_5JT=
ROLE_25JT=
TOP_SPENDER_ROLE_ID=

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DATABASE_URL=
DATABASE_URL_POOLED=

# ==========================================
# PAYMENT GATEWAY (MIDTRANS)
# ==========================================
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

# ==========================================
# SERVER & DASHBOARD
# ==========================================
PORT=3000
ADMIN_DASHBOARD_TOKEN=

# ==========================================
# ROBLOX+ & AUTOMATION CONFIGURATION
# ==========================================
# Path relatif ke folder RoValra dist (ekstensi Chrome)
ROVALRA_PATH=./rovalra/RoValra/dist

# Jalankan headless (wajib true di VPS Linux)
ROBLOX_BROWSER_HEADLESS=true
USE_MOCK_TRANSFER=false

# Link panduan 2FA untuk pembeli jika terjadi challenge
TWO_FA_GUIDE_URL=
CUSTOMER_WAIT_HOURS=12

# ==========================================
# SENDER ROBLOX COOKIES
# ==========================================
# Format: ROBLOX_COOKIE_<robloxUserId>=_|WARNING:-DO-NOT-SHARE-THIS...
ROBLOX_TEST_COOKIE=
